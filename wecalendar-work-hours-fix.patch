+// ---- work-hours guard: nothing is ever offered outside workStart–workEnd ----
+// A slot must END by workEnd, so with 30-min slots and a 5 PM end the last start is 4:30 PM.
+function workBounds(d){
+  return [new Date(d.getFullYear(), d.getMonth(), d.getDate(), S.workStart).getTime(),
+          new Date(d.getFullYear(), d.getMonth(), d.getDate(), S.workEnd).getTime()];
+}
+function clampToWork(start, end){
+  const [ws, we] = workBounds(start);
+  const s = Math.max(start.getTime(), ws), e = Math.min(end.getTime(), we);
+  return (e - s >= (S.slotLen || 30) * 60000) ? { start: new Date(s), end: new Date(e) } : null;
+}
+function workHoursMsg(d){
+  const [ws, we] = workBounds(d);
+  return "⏰ Outside your work hours — last " + (S.slotLen || 30) + "-min slot starts at " + fmtTime(new Date(we - (S.slotLen || 30) * 60000)) + " (" + fmtTime(new Date(ws)) + "–" + fmtTime(new Date(we)) + ")";
+}
